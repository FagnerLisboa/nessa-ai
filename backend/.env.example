# ============================================================
# NESSA AI — Backend · modelo de variáveis de ambiente
# Copie este arquivo para .env e preencha localmente.
# NUNCA versionar o .env com valores reais.
# ============================================================

APP_NAME=NESSA API
APP_ENV=development

# Conexão PostgreSQL (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nessa

# Origens permitidas pelo CORS — separadas por vírgula
CORS_ORIGINS=http://localhost:4200

# ------------------------------------------------------------
# Motor de IA do chat
# Padrão: AI_PROVIDER=mock (sem chamadas externas).
# Para usar o Gemini, defina AI_PROVIDER=gemini e preencha a chave
# obtida em https://aistudio.google.com/apikey — somente placeholder:
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# Provedores de IA — placeholders apenas.
# Preencher EXCLUSIVAMENTE no backend, jamais no frontend.
# ------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
